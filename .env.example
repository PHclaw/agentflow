# ============================================================================
# AgentFlow 环境配置模板
#
#   cp .env.example .env   &&   编辑 .env
#
# 键名必须与 backend/app/core/config.py 的 Settings 字段**逐字一致** ——
# pydantic-settings 认不出的键会被静默忽略，不报错。这份模板里曾经有
# ACCESS_TOKEN_EXPIRE_MINUTES / APP_DEBUG / APP_URL 三个键，代码里根本没有，
# 填了等于没填（实际字段是 JWT_EXPIRE_MINUTES / DEBUG，没有 APP_URL）。
#
# 另外**不要把 DATABASE_URL 留成空值**：空串会被当成一个真的连接串，
# SQLAlchemy 直接抛 "Could not parse SQLAlchemy URL" 让后端起不来。
# 不需要改就走默认值，写法是把整行注释掉。
# ============================================================================

# --- 必填 ---------------------------------------------------------------
# JWT 签名密钥。不填则用内置的 "change-me-in-production"，等于任何人都能
# 伪造 token。生成：openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-secret

# --- 数据库 -------------------------------------------------------------
# 留空/注释掉 = 使用默认 SQLite。
#   Docker 部署：sqlite+aiosqlite:////data/agentflow.db（四个斜杠＝绝对路径，
#   由 docker-compose 的 ./data 卷持久化，无需在 .env 里重复设置）
#   本地开发：  sqlite+aiosqlite:///./agentflow.db
#   PostgreSQL：postgresql+asyncpg://agentflow:密码@postgres:5432/agentflow
#               （需放开 backend/requirements-docker.txt 末尾的 asyncpg/pgvector）
# DATABASE_URL=

# --- Redis（可选）-------------------------------------------------------
# 用途：注册验证码的跨进程存储。不填时退回进程内存，单实例部署完全够用。
# 多 worker / 多实例必须填，否则「发码」与「校验」可能落在不同进程。
#   Docker 内网：redis://redis:6379/0
# REDIS_URL=

# --- JWT 有效期 ---------------------------------------------------------
# 单位分钟。默认 10080 = 7 天
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- 大模型 API Key（可选）----------------------------------------------
# 注意：这些只是 .env 层的兜底。正式用法是登录后在「设置 → 模型配置」里
# 添加端点与模型名（支持任意 OpenAI 兼容端点，含本地 Ollama），改完即时生效。
# 两者都存在时以「模型配置」里的为准。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 向量嵌入（知识库用）-----------------------------------------------
# 单独配置、与对话模型解耦：知识库要用向量模型，不该为此改掉正在用的对话模型。
# 本地 Ollama 只需填 EMBEDDING_BASE_URL=http://localhost:11434/v1，无需密钥。
# 留空则回退到 sentence-transformers 本地推理 —— **Docker 镜像里没装它**
# （会多约 2GB），所以容器部署请务必填这一项。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- 大模型配置热加载 ---------------------------------------------------
# 生效配置的快照缓存秒数。同进程内改完立即生效，多 worker 下最迟该秒数后一致
LLM_CONFIG_CACHE_TTL_SECONDS=5
LLM_CONFIG_TEST_TIMEOUT=20

# --- 应用 ---------------------------------------------------------------
APP_NAME=AgentFlow
# 生产环境务必改成 false：为 true 时接口会把内部异常原文返回给调用方
DEBUG=false
LOG_LEVEL=INFO

# --- CORS ---------------------------------------------------------------
# 逗号分隔。**Docker 部署通常不需要配置**：前端 nginx 会把 /api 反代到后端，
# 浏览器看到的是同源请求。这里的值只服务于本地开发那种跨端口调试。
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- 文件存储 -----------------------------------------------------------
# 上传目录。容器里由 AGENTFLOW_UPLOADS_DIR 覆盖为 /repo/uploads（见 compose）
# UPLOAD_DIR=./uploads
# 单个上传文件大小上限（字节）。默认 50MB
MAX_FILE_SIZE=52428800

# --- 邮件（注册验证码）--------------------------------------------------
# MAIL_ENABLED=false 时不真的发信，验证码只打印在后端日志里
# （以 [MAIL_ENABLED=false] 开头），方便本地开发与内网演示。
#
# MAIL_PASSWORD 填的是邮箱「授权码」，不是登录密码：
#   QQ 邮箱  → 设置 → 账户 → 开启 SMTP → 生成授权码
#   163 邮箱 → 设置 → POP3/SMTP/IMAP → 开启 → 新增授权密码
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
# 留空则使用 MAIL_USER
MAIL_FROM=
MAIL_FROM_NAME=AgentFlow
# 465 用 true（SSL 直连）；587/25 改为 false（STARTTLS）
MAIL_USE_SSL=true
MAIL_TIMEOUT=10
# 邮件页头 logo（建议 68x68 方形 PNG，走 HTTPS）。
# 留空则用「色块 + 品牌首字母」自动生成 —— 多数邮件客户端默认不加载图片，
# 不依赖图片反而更稳。
MAIL_LOGO_URL=
# 对外可访问的站点地址（协议 + 域名，不带路径），如 https://agentflow.example.com
# 邮件里只能靠它引用品牌标识 PNG：内联 SVG 被 Outlook/Gmail 丢弃，
# base64 图被 Windows 版 Outlook 屏蔽，只剩绝对 http/https 一条路。
# 留空则邮件页头用纯文字双色字标，不引任何图片。
PUBLIC_BASE_URL=

# --- 注册与验证码 -------------------------------------------------------
# 注册是否必须通过邮箱验证码。生产请保持 true；内网演示可设 false
REQUIRE_EMAIL_CODE=true
# 验证码有效期（秒）。别设太短：邮件投递经过多级中继，慢的时候一两分钟才到，
# 有效期比投递延迟长不了多少的话，用户拿到码时已经没剩多少时间了。
CODE_TTL_SECONDS=600
CODE_LENGTH=6
CODE_RESEND_INTERVAL=60
CODE_HOURLY_LIMIT=5
CODE_MAX_ATTEMPTS=5
# /auth/send-code 的 IP 级限流。公司/学校共用出口 IP 时容易误伤，可按需放宽
SEND_CODE_IP_LIMIT=10
SEND_CODE_IP_WINDOW=3600

# --- 管理员 -------------------------------------------------------------
# 管理员邮箱白名单，逗号分隔。命中者在登录/注册时获得管理后台权限。
# 用配置而不是改数据库来指定首个管理员：全新部署时管理员记录还不存在，
# 改库那条路走不通。改完重新登录一次即生效。
# 只授予不回收 —— 移除配置项不会把已有管理员降级。
ADMIN_EMAILS=

# --- 套餐额度 -----------------------------------------------------------
# **只在这里定义一份**：套餐文案、额度判定、用量接口都从这取，
# 避免出现「宣传 20 个 Agent、实际按 5 个判」这类不一致。
FREE_AGENTS=1
FREE_MESSAGES=5
PRO_AGENTS=5
PRO_MESSAGES=150
TEAM_AGENTS=20
TEAM_MESSAGES=666

# --- Stripe 支付（可选）------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_TEAM=price_team_monthly

# --- Skill 运行时网关（可选，ChatZOC / 百炼兼容）------------------------
# CHATZOC_API_KEY=
# CHATZOC_BASE_URL=
# CHATZOC_AGENT_TYPE=chatzoc_9b_B
# DASHSCOPE_API_KEY=
# MODEL_BASE_URL=
# SEMANTIC_SCHOLAR_API_KEY=

# --- 仅供 docker-compose 使用（不是应用配置）----------------------------
# 这两个是 compose 自己读的端口映射变量，应用代码不认。
# FRONTEND_PORT=3000
# BACKEND_PORT=8001
