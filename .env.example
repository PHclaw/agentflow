# ============================================
# AgentFlow 环境配置示例
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# --- 数据库 ---
# PostgreSQL（推荐生产使用）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentflow
# SQLite（开发备用，不填则自动使用）
DATABASE_URL=

# --- Redis（可选，用于缓存和会话管理） ---
# REDIS_URL=redis://localhost:6379/0

# --- JWT 认证 ---
# 生产环境请使用强随机密钥：openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- LLM API Keys ---
# 至少需要配置一个 LLM 提供商
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Skill 运行时（可选，ChatZOC / 百炼兼容网关）---
# CHATZOC_API_KEY=
# CHATZOC_BASE_URL=
# CHATZOC_AGENT_TYPE=chatzoc_9b_B
# DASHSCOPE_API_KEY=
# MODEL_BASE_URL=
# DEFAULT_MODEL=gpt-4o-mini

# --- 应用配置 ---
APP_NAME=AgentFlow
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- CORS（允许的前端地址，逗号分隔） ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Stripe 支付（可选） ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- PiAgent 引擎（可选，需要本机已安装 pi CLI）---
# 安装：npm install -g @earendil-works/pi-coding-agent
# 开启后可用 /api/v1/pi/{agent_id}/stream（SSE）作为 Agent 的可选推理引擎
PIAGENT_ENABLED=false
PIAGENT_EXE=pi
PIAGENT_TIMEOUT=180
# pi 默认 provider 是 google；如需与项目模型一致可显式指定
# PIAGENT_PROVIDER=openai
# PIAGENT_MODEL=gpt-4o-mini
# 工作区与技能目录（留空使用默认值：uploads/pi_workspace 与仓库根 skills/）
# PIAGENT_WORKSPACE_ROOT=
# PIAGENT_SKILLS_DIR=
