# AgentFlow 环境变量示例
# 复制此文件为 .env 并填写实际值

# ===== 应用基础 =====
APP_NAME=AgentFlow
DEBUG=true
LOG_LEVEL=INFO

# ===== 数据库 =====
# SQLite (开发)
DATABASE_URL=sqlite+aiosqlite:///./agentflow.db
# PostgreSQL (生产)
# DATABASE_URL=postgresql+asyncpg://agentflow:password@localhost:5432/agentflow

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== LLM (至少填写一个) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== Embedding =====
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===== CORS =====
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ===== 订阅限制 =====
FREE_AGENTS=1
FREE_MESSAGES=5
PRO_AGENTS=5
PRO_MESSAGES=150
TEAM_AGENTS=20
TEAM_MESSAGES=666

# ===== Stripe (可选) =====
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=

# ===== agent-* 生态 (可选，未安装时自动回退) =====
# AGENT_CONFIG_ENV=development
# OBSERVABILITY_ENABLED=true

# ===== 邮件（注册验证码）=====
# MAIL_ENABLED=false 时不会真的发信，验证码只打印到后端日志，便于本地开发与测试。
# MAIL_PASSWORD 填的是邮箱「授权码」，不是登录密码：
#   QQ 邮箱   → 设置 → 账户 → 开启 SMTP → 生成授权码
#   163 邮箱  → 设置 → POP3/SMTP/IMAP → 开启 → 新增授权密码
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
# 留空则使用 MAIL_USER
MAIL_FROM=
MAIL_FROM_NAME=AgentFlow
# 邮件页头 logo（建议 68x68 方形 PNG，HTTPS）。
# 留空则用「色块 + 品牌首字母」自动生成 —— 多数客户端默认不加载图片，不依赖图更稳。
MAIL_LOGO_URL=
# 对外可访问的站点地址（协议 + 域名，不带路径），如 https://agentflow.example.com。
# 邮件里只能靠它引用品牌标识 PNG：内联 SVG 被 Outlook/Gmail 丢弃，
# base64 图被 Windows 版 Outlook 屏蔽，只剩绝对 http/https 这一条路。
# 留空则邮件页头用纯文字的双色字标，不引任何图片。
PUBLIC_BASE_URL=

# 管理员邮箱白名单，逗号分隔。命中者在登录/注册时获得管理后台权限。
# 用配置而不是改数据库来指定首个管理员：全新部署时管理员记录还不存在，
# 改库那条路走不通。改完这里重新登录一次即可生效。
# 只授予、不回收 —— 移除配置项不会把已有管理员降级。
ADMIN_EMAILS=

# 465 端口用 true（SSL 直连）；587/25 改为 false（STARTTLS）
MAIL_USE_SSL=true
MAIL_TIMEOUT=10
# 注册是否必须通过邮箱验证码。生产环境请保持 true
REQUIRE_EMAIL_CODE=true
# 验证码策略
# 有效期别设太短：邮件投递经过多级中继，慢的时候一两分钟才到。
CODE_TTL_SECONDS=600
CODE_LENGTH=6
CODE_RESEND_INTERVAL=60
CODE_HOURLY_LIMIT=5
CODE_MAX_ATTEMPTS=5
